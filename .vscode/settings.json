{
  "explorer.compactFolders": false,
  "explorer.autoReveal": true,
  "workbench.tree.expandMode": "singleClick",
  "files.exclude": {
    "**/.git": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/.pytest_cache/**": true
  }
}
